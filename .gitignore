#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Control plane stays on the machine that runs it
/server/
/docs/
/tool/

# Signing material
**/key.properties
**/*.jks
**/*.keystore

# Subscription QR images
/assets/pulse-test-*.png

# sing-box Windows binary, downloaded at build time
/third_party/sing-box/

# Plugin and native build output
**/build/
**/.gradle/
**/.cxx/

# Built on CI / locally — do not commit
ios/Frameworks/Libbox.xcframework/
third_party/sing_box/ios/Frameworks/Libbox.xcframework/

# Local release artifacts dropped in the repo root
/*.apk
/*.exe
/K-Pax-*.apk
/K-Pax-Setup-*.exe
/X-Plm-*.apk
/X-Plm-Setup-*.exe
/k-pax-*-preview.apk

