# Canonical sing-box / Libbox version pins for K-Pax / X-Plm.
# CI: scripts/check-singbox-version-pins.ps1 (also invoked from GitHub Actions).
#
# SINGBOX_RELEASE — Windows binary (provision-windows-native.ps1) + iOS Libbox
#                   (build_libbox.sh / Codemagic LIBBOX_SINGBOX_TAG) + config smoke.
# ANDROID_LIBBOX  — JitPack artifact used by third_party/flutter_singbox_vpn.
# ANDROID_LIBBOX_TARGET — desired Android alignment; blocked until a complete AAR
#                   with Libbox.newService / BoxService ships for this tag.
SINGBOX_RELEASE=1.13.21
ANDROID_LIBBOX=1.12.12
ANDROID_LIBBOX_TARGET=1.13.21
