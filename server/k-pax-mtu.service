[Unit]
Description=K-Pax TCP MSS clamp
After=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c '/sbin/iptables -t mangle -D OUTPUT -p tcp --sport 443 -j TCPMSS --set-mss 1240 || true; /sbin/iptables -t mangle -C OUTPUT -p tcp --sport 443 -j TCPMSS --set-mss 1100 || /sbin/iptables -t mangle -A OUTPUT -p tcp --sport 443 -j TCPMSS --set-mss 1100'
ExecStart=/bin/sh -c '/sbin/iptables -t mangle -D INPUT -p tcp --dport 443 -j TCPMSS --set-mss 1240 || true; /sbin/iptables -t mangle -C INPUT -p tcp --dport 443 -j TCPMSS --set-mss 1100 || /sbin/iptables -t mangle -A INPUT -p tcp --dport 443 -j TCPMSS --set-mss 1100'
ExecStart=/bin/sh -c '/sbin/iptables -t mangle -C OUTPUT -p tcp --sport 8443 -j TCPMSS --set-mss 1100 || /sbin/iptables -t mangle -A OUTPUT -p tcp --sport 8443 -j TCPMSS --set-mss 1100'
ExecStart=/bin/sh -c '/sbin/iptables -t mangle -C INPUT -p tcp --dport 8443 -j TCPMSS --set-mss 1100 || /sbin/iptables -t mangle -A INPUT -p tcp --dport 8443 -j TCPMSS --set-mss 1100'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
